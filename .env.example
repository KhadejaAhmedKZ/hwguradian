# Copy to .env.local and fill in. .env.local is gitignored.
# Values come from Firebase console → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions region (must match functions/src/index.ts)
VITE_FUNCTIONS_REGION=us-central1

# Point the extension at local emulators instead of production (true/false)
VITE_USE_EMULATORS=false

# OPTIONAL / DEV ONLY. Leave EMPTY for any build you actually install.
# If set, Gemini is called directly from the extension, which means the key is
# readable by anyone who unpacks the extension. The supported path is the
# `geminiAssist` Cloud Function, which keeps the key server-side.
VITE_GEMINI_API_KEY=
